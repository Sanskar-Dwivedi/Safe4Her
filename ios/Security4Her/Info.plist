<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Security4Her</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>in.security4her.verification</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>security4her</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>Record video evidence while Security4Her is visible during an SOS.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Continue a journey or SOS location session while your iPhone screen is locked.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Share your position during an SOS or journey and find nearby safe places.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Record audio evidence during an SOS that you start.</string>
	<key>NSMotionUsageDescription</key>
	<string>Detect an optional triple-knock gesture while Security4Her is open.</string>
	<key>S4HLiveURL</key>
	<string>$(S4H_LIVE_URL)</string>
	<key>S4HSupabaseAnonKey</key>
	<string>$(S4H_SUPABASE_ANON_KEY)</string>
	<key>S4HSupabaseURL</key>
	<string>$(S4H_SUPABASE_URL)</string>
	<key>S4HTrackingURL</key>
	<string>$(S4H_TRACKING_URL)</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>location</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
